# Copie para o ambiente do servidor. Não coloque estes valores no cliente.
# O arquivo .env real não deve ser commitado.

# Postgres/Neon. Obrigatório em produção. Sem isso, preview local usa PGLite.
DATABASE_URL=postgres://user:password@host/db

# Better Auth
BETTER_AUTH_SECRET=troque-por-um-segredo-longo
BETTER_AUTH_URL=http://127.0.0.1:8080

# IA no servidor. Nunca prefixe com VITE_.
XAI_API_KEY=
GEMINI_API_KEY=
# grok (padrão) ou gemini
CALU_AI_PROVIDER=grok

# Marca o processo. development | preview | production | test
# production sem DATABASE_URL não sobe. preview, test e development podem usar PGLite.
# CALU_ENV=development

# Só para a suíte Postgres. Nunca aponte para produção.
# CALU_TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/smartnutri_test

